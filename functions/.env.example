# Beispiel-Env für lokale Entwicklung des Sofort-Skizze-Endpunkts.
# Echte Werte NICHT committen (siehe .gitignore).
#
# In Produktion wird der Anthropic-Key als Firebase-Secret hinterlegt:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Lokal kann er über functions/.env (oder die Shell) gesetzt werden.

# Anthropic API-Key — NUR serverseitig, niemals im Client.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell überschreiben (Default: claude-haiku-4-5).
# Für maximale Textqualität: claude-opus-4-8
# SOFORT_SKIZZE_MODEL=claude-haiku-4-5
